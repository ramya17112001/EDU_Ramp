package com.billing_service.service;

import java.math.BigDecimal;
import java.time.LocalDateTime;
import java.time.YearMonth;
import java.util.Date;
import java.util.List;
import java.util.stream.Collectors;

import org.modelmapper.ModelMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.billing_service.dto.Plan;
import com.billing_service.dto.BillSummaryDto;
import com.billing_service.entity.Bill;
import com.billing_service.exception.BillNotFoundException;
//import com.billing_service.dto.BillSummaryDto;
//import com.billing_service.entity.Bill;
//import com.billing_service.exception.BillNotFoundException;
// import com.billing_service.exception.BillingNotFoundException;
import com.billing_service.repository.BillRepository;

@Service
public class BillingService {
	@Autowired
    private BillRepository billRepository;

    @Autowired
    private ModelMapper modelMapper;

    public Plan generateBill(Long userId, Double amount, String details) {
        Bill bill = new Bill(userId, amount, new Date(), details);
        bill = billRepository.save(bill);
        return modelMapper.map(bill, Plan.class);
    }
    public List<BillSummaryDto> getAllBillingHistory() {
        List<Bill> bills = billRepository.findAll();
        return bills.stream()
            .map(b -> {
                BillSummaryDto dto = new BillSummaryDto();
                dto.setBillId(b.getId());
                dto.setTotalAmount(b.getTotalAmount());
                dto.setBillDate(b.getBillDate());
                return dto;
            })
            .collect(Collectors.toList());
    }
 
 
    public List<BillSummaryDto> getBillingHistory(Long userId) {
        List<Bill> bills = billRepository.findByUserId(userId);
        return bills.stream()
                .map(b -> {
                    BillSummaryDto dto = new BillSummaryDto();
                    dto.setBillId(b.getId());
                     dto.setTotalAmount(b.getTotalAmount());
                    dto.setBillDate(b.getBillDate());
                    return dto;
                }) 
                .collect(Collectors.toList());
    }

    public Plan getBillById(Long billId) {
        Bill bill = billRepository.findById(billId)
                .orElseThrow(() -> new BillNotFoundException("Bill not found: " + billId));
        return modelMapper.map(bill, Plan.class);
    }   
    public Plan updateBill(Long billId, Plan billDto) {
        Bill bill = billRepository.findById(billId)
                .orElseThrow(() -> new BillNotFoundException("Bill not found: " + billId));
        bill.setTotalAmount(billDto.getTotalAmount());
        bill.setBillDate(billDto.getBillDate());
        bill.setDetails(billDto.getDetails());
        Bill updated = billRepository.save(bill);
        return modelMapper.map(updated, Plan.class);
    }

    public void deleteBill(Long billId) {
        if (!billRepository.existsById(billId))
            throw new BillNotFoundException("Bill not found: " + billId);
        billRepository.deleteById(billId);
    }  
 
}	 