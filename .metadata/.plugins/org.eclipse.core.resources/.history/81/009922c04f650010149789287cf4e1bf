package com.usage_service.dto;


import lombok.*;

import java.time.LocalDate;
import java.time.LocalDateTime;
@Data
public class UsageLogDTO {
	 private String userId;
	    private LocalDate date;
	    private int callDuration;
	    private double dataUsed;
	    private int smsCount;
		public String getUserId() {
			return userId;
		}
		public void setUserId(String userId) {
			this.userId = userId;
		}
		public LocalDate getDate() {
			return date;
		}
		public void setDate(LocalDate date) {
			this.date = date;
		}
		public int getCallDuration() {
			return callDuration;
		}
		public void setCallDuration(int callDuration) {
			this.callDuration = callDuration;
		}
		public double getDataUsed() {
			return dataUsed;
		}
		public void setDataUsed(double dataUsed) {
			this.dataUsed = dataUsed;
		}
		public int getSmsCount() {
			return smsCount;
		}
		public void setSmsCount(int smsCount) {
			this.smsCount = smsCount;
		}
		public UsageLogDTO(String userId, LocalDate date, int callDuration, double dataUsed, int smsCount) {
			super();
			this.userId = userId;
			this.date = date;
			this.callDuration = callDuration;
			this.dataUsed = dataUsed;
			this.smsCount = smsCount;
		}
	    
	}
 
	