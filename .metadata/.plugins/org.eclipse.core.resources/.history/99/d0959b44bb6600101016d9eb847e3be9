@RestController
@RequestMapping("/billing")
public class BillingController {
	@Autowired
    private BillingService billingService;

    @PostMapping("/generate/{userId}")
    public Bill generateBill(@PathVariable Long userId,
                              @RequestParam Double usageData,
                             @RequestParam(required = false) String planType) {
        // Dummy usage of external models (In real code, fetch usage/plan/user from other MS)
        User user = new User(userId, "Sample User");
        Plan plan = new Plan(1L, "SUPER", planType != null ? planType : "PREPAID", 199, 28, 100, 2.0);
        Usage usage = new Usage(userId, new java.util.Date(), 300, usageData, 10);

        return billingService.generateBill(user, plan, usage);
    }

    @GetMapping("/history")
    public List<Bill> getHistory(@RequestParam Long userId) {
        return billingService.getBillingHistory(userId);
    }

    @GetMapping("/{billId}")
    public Bill getBill(@PathVariable Long billId) {
        return billingService.getBill(billId);
    }
}
 
