server:
  port: 8085

spring:
  application:
    name: billing-service
  datasource:
    url: jdbc:mysql://localhost:3306/smarttelecom?useSSL=false&serverTimezone=UTC
    username: telecom
    password: telecompass
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate.dialect: org.hibernate.dialect.MySQL8Dialect

  data:
    mongodb:
      uri: mongodb://localhost:27017/smarttelecom

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
    register-with-eureka: true
    fetch-registry: true
