package com.plan_service.service;

import java.util.List;
import java.util.stream.Collectors;

import org.modelmapper.ModelMapper;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.plan_service.dto.PlanDTO;
import com.plan_service.dto.PlanRequest;
import com.plan_service.entity.Plan;
import com.plan_service.entity.PlanType;
import com.plan_service.exception.PlanNotFoundException;
import com.plan_service.repository.PlanRepository;
 
import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class PlanService {
	 @Autowired
	    private PlanRepository planRepository;

	    @Autowired
	    private ModelMapper modelMapper;

	    // ✅ Get all plans (with optional filter by type)
	    public List<PlanDTO> getAll(String type) {
	         List<Plan> plans = (type != null) ? planRepository.findByType(type) : planRepository.findAll();
	        return plans.stream()
	                .map(plan -> modelMapper.map(plan, PlanDTO.class))
	                .collect(Collectors.toList());
	    }

	    // ✅ Create new plan
	    public PlanDTO create(PlanDTO dto) {
	        Plan plan = modelMapper.map(dto, Plan.class);
	        Plan saved = planRepository.save(plan);
	        return modelMapper.map(saved, PlanDTO.class);
	    }

	    // ✅ Update plan
	    public PlanDTO update(Long id, PlanDTO dto) {
	        Plan plan = planRepository.findById(id)
	                .orElseThrow(() -> new PlanNotFoundException("Plan not found with id: " + id));

	        plan.setName(dto.getName());
	        plan.setType(dto.getType());
	        plan.setPrice(dto.getPrice());
	        plan.setValidity(dto.getValidity());
	        plan.setFeatures(dto.getFeatures());

	        Plan updated = planRepository.save(plan);
	        return modelMapper.map(updated, PlanDTO.class);
	    }

	    // ✅ Delete plan
	    public void delete(Long id) {
	        if (!planRepository.existsById(id)) {
	            throw new PlanNotFoundException("Plan not found with id: " + id);
	        }
	        planRepository.deleteById(id);
	    } 
	}
