server:
  port: 8082

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/usert_db
    username: root
    password: Kanny@2317
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    database-platform: org.hibernate.dialect.MySQL8Dialect

  application:
    name: user-service

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
    register-with-eureka: true
    fetch-registry: true

# JWT custom properties if you want to externalize:
jwt:
  secret: verysecretkey
  expiration: 86400000 # (ms) = 24h

management:
  endpoints:
    web:
      exposure:
        include: "*"
