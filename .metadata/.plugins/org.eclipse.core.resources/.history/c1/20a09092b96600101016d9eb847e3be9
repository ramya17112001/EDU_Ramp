@Service
public class BillingService {
	@Autowired
    private BillRepository billRepository;
 
    // Observers
    private final List<NotificationObserver> observers = Arrays.asList(
            new EmailObserver(),
            new SMSObserver()
    );

    // Strategy selection can be made dynamic based on plan type
    private final BillingStrategy prepaidStrategy = new PrepaidBillingStrategy();

    public Bill generateBill(User user, Plan plan, Usage usage) {
        // 1. Calculate bill amount using strategy
        double billAmount = prepaidStrategy.calculateBill(usage, plan);

        // 2. Save bill
        Bill bill = new Bill(user.getId(), billAmount, new Date(), "Generated by system");
        Bill saved = billRepository.save(bill);

        // 3. Notify user (custom message)
        String msg = String.format("Dear %s, your bill of Rs.%.2f is generated.", user.getName(), billAmount);
        observers.forEach(obs -> obs.notify(user.getId(), msg));

        return saved;
    }

    public List<Bill> getBillingHistory(Long userId) {
        return billRepository.findByUserId(userId);
    }

    public Bill getBill(Long billId) {
        return billRepository.findById(billId)
                .orElseThrow(() -> new RuntimeException("Bill not found"));
    }

