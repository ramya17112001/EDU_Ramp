server:
  port: 8086

spring:
  application:
    name: billing-service
  datasource:
    url: jdbc:mysql://localhost:3306/smarttelecom_billing?useSSL=false&serverTimezone=UTC
    username: root
    password: rootpass
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

eureka:
  client:
    serviceUrl:
      defaultZone: http://localhost:8761/eureka
    registerWithEureka: true
    fetchRegistry: true
