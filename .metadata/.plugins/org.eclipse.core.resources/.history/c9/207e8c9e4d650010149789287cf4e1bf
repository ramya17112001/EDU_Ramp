package com.usage_service.dto;


import lombok.*;

import java.time.LocalDateTime;
@Getter @Setter @NoArgsConstructor @AllArgsConstructor @Builder
public class UsageLogDTO {
	private Long id;
	  private Long userId;
	  private LocalDateTime timestamp;
	  private Integer callDuration;
	  private Integer dataUsedMb;
	  private Integer smsCount;
	public Long getId() {
		return id;
	}
	public void setId(Long id) {
		this.id = id;
	}
	public Long getUserId() {
		return userId;
	}
	public void setUserId(Long userId) {
		this.userId = userId;
	}
	public LocalDateTime getTimestamp() {
		return timestamp;
	}
	public void setTimestamp(LocalDateTime timestamp) {
		this.timestamp = timestamp;
	}
	public Integer getCallDuration() {
		return callDuration;
	}
	public void setCallDuration(Integer callDuration) {
		this.callDuration = callDuration;
	}
	public Integer getDataUsedMb() {
		return dataUsedMb;
	}
	public void setDataUsedMb(Integer dataUsedMb) {
		this.dataUsedMb = dataUsedMb;
	}
	public Integer getSmsCount() {
		return smsCount;
	}
	public void setSmsCount(Integer smsCount) {
		this.smsCount = smsCount;
	}
	public UsageLogDTO(Long id, Long userId, LocalDateTime timestamp, Integer callDuration, Integer dataUsedMb,
			Integer smsCount) {
		super();
		this.id = id;
		this.userId = userId;
		this.timestamp = timestamp;
		this.callDuration = callDuration;
		this.dataUsedMb = dataUsedMb;
		this.smsCount = smsCount;
	}
	   
}
