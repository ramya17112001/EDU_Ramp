server:
  port: 8086

spring:
  application:
    name: usage-service

  data:
    mongodb:
      uri: mongodb://localhost:27017/smarttelecom

eureka:
  client:
    service-url:
      defaultZone: http://localhost:8761/eureka
    register-with-eureka: true
    fetch-registry: true

logging:
  level:
    org.springframework.data.mongodb: DEBUG
